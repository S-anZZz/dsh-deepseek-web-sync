{
  "name": "dsh-deepseek-web-sync",
  "version": "3.1.0",
  "description": "DeepSeek Web in the right Sidebar with synchronized theme, automatic launch, and a one-time web sign-in kept across launches.",
  "author": "ZCFE327",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/S-anZZz/dsh-deepseek-web-sync.git"
  },
  "homepage": "https://github.com/S-anZZz/dsh-deepseek-web-sync",
  "bugs": {
    "url": "https://github.com/S-anZZz/dsh-deepseek-web-sync/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "sidebar",
    "webview",
    "theme-sync"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "QUICKSTART.md",
    "docs/ARTICLE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
